# Generate .env with scripts/local-secrets.sh; keep actual credentials out of Git.
POSTGRES_DB=releaseops
POSTGRES_USER=releaseops
POSTGRES_PASSWORD=replace-with-generated-local-secret
APP_VERSION=0.1.0
WORKER_POLL_SECONDS=2
WORKER_PROCESS_SECONDS=3
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-generated-local-secret
